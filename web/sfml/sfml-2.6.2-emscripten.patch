+////////////////////////////////////////////////////////////
+void SoundStream::launchStreaming()
+{
+    priv::emscriptenFrameHook = &SoundStream::pumpStreams;
+    if (!streamBegin())
+        return;
+    m_streamActive = true;
+    activeStreams().push_back(this);
+}
+
+
+////////////////////////////////////////////////////////////
+void SoundStream::waitStreaming()
+{
+    if (!m_streamActive)
+        return;
+    std::vector<SoundStream*>& streams = activeStreams();
+    streams.erase(std::remove(streams.begin(), streams.end(), this), streams.end());
+    m_streamActive = false;
+    streamEnd();
+}
+
+#else
+
