+////////////////////////////////////////////////////////////
+void SoundStream::pumpStreams()
+{
+    std::vector<SoundStream*>& streams = activeStreams();
+    for (std::size_t i = 0; i < streams.size();)
+    {
+        SoundStream* stream = streams[i];
+        if (stream->streamStep())
+        {
+            ++i;
+            continue;
+        }
+        streams.erase(streams.begin() + static_cast<std::ptrdiff_t>(i));
+        stream->m_streamActive = false;
+        stream->streamEnd();
+    }
+}
